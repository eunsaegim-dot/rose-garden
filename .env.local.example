# Copy this file to .env.local and fill in your Firebase web app config
# (Firebase Console -> Project settings -> General -> "Your apps" -> the
# web app -> SDK setup and configuration -> Config).
#
# .env.local is gitignored (see .gitignore's `*.local` rule) and is never
# committed. For the GitHub Pages deploy, the same values are provided via
# GitHub Actions repository secrets instead (Settings -> Secrets and
# variables -> Actions) — see .github/workflows/deploy.yml.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=rose-garden-e1e75
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
